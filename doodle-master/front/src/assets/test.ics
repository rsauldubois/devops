 LE=NON-PARTICIPANT;PARTSTAT=ACCEPTED;RSVP=TRUE:mailto:rennes-salle_sicile@zi
 mbra-local.inria.fr
ORGANIZER;CN=Benoit Combemale:mailto:benoit.combemale@irisa.fr
